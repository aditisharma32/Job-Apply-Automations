# ---------- Sending account (Gmail API only — no SMTP) ----------
EMAIL_USER=works.dubeyharsh@gmail.com
EMAIL_FROM_NAME=Harsh Dubey
EMAIL_REPLY_TO=

# OAuth — the SAME client + refresh token as job_mail_autmation works here
# (scopes gmail.send + gmail.modify). Else: npm run google-token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------- OpenRouter (parses the confirmation emails) ----------
OPENROUTER_API_KEY=
# Pick a model your account can use — check https://openrouter.ai/models
# Good cheap options: google/gemini-2.5-flash , openai/gpt-4o-mini ,
# meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=google/gemini-2.5-flash

# ---------- Tracking sheet (its own NEW sheet + Apps Script) ----------
# Deploy apps-script/Code.gs as a web app; paste the /exec URL here.
SHEET_API=https://script.google.com/macros/s/XXXXXXXX/exec
SHEET_API_TOKEN=

# ---------- Behaviour ----------
PORT=3000
# cron-job.org sends this as header "x-poll-secret" or "?key="
POLL_SECRET=change-me
# How far back to look for new application emails.
POLL_LOOKBACK_DAYS=2
# Max outreach emails per poll.
MAX_PER_POLL=10
SEND_DELAY_MS=2000
# Ignore an LLM extraction below this confidence.
MIN_CONFIDENCE=0.6
# Gmail label put on every handled email so it's never processed twice.
DONE_LABEL=outreach-done
# Extra confirmation senders/subjects, comma-separated (e.g. from:jobs@x.com,subject:"applied")
EXTRA_SENDERS=
# Scan bounces before each poll and mark rows "Bounced".
PROCESS_BOUNCES=true
BOUNCE_LOOKBACK_DAYS=3
# Preview only — no send, no sheet writes, no labels.
DRY_RUN=false

# ---------- Email content ----------
EMAIL_SUBJECT=Following up on my application for {{title}} at {{company}}

POLL_SECRET=

